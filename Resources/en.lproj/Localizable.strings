"alg.opstarten.toggle" = "Start Dopamine Code as soon as I log in";
"alg.opstarten.uitleg" = "The app then sits ready in the menu bar. Keeping awake does not switch on by itself — that stays a click of yours.";
"alg.opstarten.wacht" = "macOS is still waiting for your approval for this.";
"alg.opstarten.openen" = "Open";

