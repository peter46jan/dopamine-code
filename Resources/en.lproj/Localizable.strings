/* --- Instellingen · Diagnose: de wachter --- */
"diag.wachter.titel" = "The watchdog, for when the app disappears";
"diag.wachter" = "Watchdog";
"diag.wachter.uitleg" = "If Dopamine Code is killed outright — kill -9, or a crash — there is no chance left to put the sleep block back, and the Mac stays awake until the battery is empty. So every 30 seconds a small watchdog checks whether the block is on while the app is no longer running; in that case it starts the app again, which then cleans up itself. It never switches anything by itself, and after a normal Quit it does not come back.";
"diag.wachter.vanzelf" = "This happens by itself and cannot be switched off — just like the temperature watch.";
"diag.wachter.herstellen" = "Repair watchdog";

